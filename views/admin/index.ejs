<div class="page-header">
  <div>
    <h1>Admin</h1>
    <p>Gerenciamento da plataforma</p>
  </div>
</div>

<div class="filters">
  <a class="btn <%= path === '/admin' ? 'btn-secondary' : 'btn' %>" href="/admin">Dashboard</a>
  <a class="btn <%= path === '/admin/users' ? 'btn-secondary' : 'btn' %>" href="/admin/users">Usuários</a>
  <a class="btn <%= path === '/admin/courses' ? 'btn-secondary' : 'btn' %>" href="/admin/courses">Cursos</a>
  <a class="btn <%= path === '/admin/docs' ? 'btn-secondary' : 'btn' %>" href="/admin/docs">Docs</a>
  <a class="btn <%= path === '/admin/examples' ? 'btn-secondary' : 'btn' %>" href="/admin/examples">Playground</a>
  <a class="btn <%= path === '/admin/hackathons' ? 'btn-secondary' : 'btn' %>" href="/admin/hackathons">Hackathons</a>
  <a class="btn <%= path === '/admin/packages' ? 'btn-secondary' : 'btn' %>" href="/admin/packages">Pacotes</a>
</div>
<div id="admin-content"></div>
<script>
const token = localStorage.getItem('token');
if (!token) { window.location.href = '/login'; }

const section = window.location.pathname.split('/').pop() || 'dashboard';
const content = document.getElementById('admin-content');

function escapeHtml(str) {
  if (!str) return '';
  const d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}

async function loadSection() {
  content.innerHTML = '<div class="empty-state">Carregando...</div>';
  try {
    if (section === 'dashboard') {
      const res = await fetch('/api/admin/stats', { headers: { 'Authorization': 'Bearer ' + token } });
      const json = await res.json();
      if (!json.ok) { content.textContent = json.error; return; }
      content.innerHTML = '<div class="grid grid-4">' +
        Object.entries(json.stats).map(([k, v]) => '<div class="card stat-card"><span class="stat-value">' + v + '</span><span class="stat-label">' + k + '</span></div>').join('') +
        '</div>';
    } else if (section === 'users') {
      const res = await fetch('/api/admin/users', { headers: { 'Authorization': 'Bearer ' + token } });
      const json = await res.json();
      content.innerHTML = '<div class="card"><div class="table-wrap"><table><thead><tr><th>Usuário</th><th>Email</th><th>Role</th><th>Ações</th></tr></thead><tbody>' +
        json.users.map(u => '<tr><td>' + escapeHtml(u.username) + '</td><td class="muted">' + escapeHtml(u.email) + '</td><td>' + escapeHtml(u.role) + '</td><td><button onclick="toggleRole(\'' + u._id + '\')" class="btn btn-secondary btn-sm">' + (u.role === 'admin' ? 'Remover admin' : 'Tornar admin') + '</button></td></tr>').join('') +
        '</tbody></table></div></div>';
    } else if (section === 'courses') {
      const res = await fetch('/api/admin/courses', { headers: { 'Authorization': 'Bearer ' + token } });
      const json = await res.json();
      content.innerHTML = '<div class="card"><div class="card-header">Cursos</div><div class="table-wrap"><table><thead><tr><th>Título</th><th>Slug</th><th>Status</th><th>Ações</th></tr></thead><tbody>' +
        json.courses.map(c => '<tr><td>' + escapeHtml(c.title) + '</td><td class="muted">' + escapeHtml(c.slug) + '</td><td>' + (c.published ? '<span class="badge badge-success">Publicado</span>' : '<span class="badge badge-neutral">Rascunho</span>') + '</td><td><button onclick="deleteCourse(\'' + c._id + '\')" class="btn btn-outline-danger btn-sm">Excluir</button></td></tr>').join('') +
        '</tbody></table></div></div>';
    } else {
      content.innerHTML = '<div class="empty-state">Selecione uma seção no menu acima.</div>';
    }
  } catch (e) {
    content.textContent = 'Erro: ' + e.message;
  }
}

async function toggleRole(id) {
  const role = prompt('Novo role (user/admin):');
  if (!role) return;
  await fetch('/api/admin/users/' + id + '/role', { method: 'PATCH', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token }, body: JSON.stringify({ role }) });
  loadSection();
}
async function deleteCourse(id) { if (confirm('Excluir curso?')) { await fetch('/api/admin/courses/' + id, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token } }); loadSection(); } }

loadSection();
</script>
