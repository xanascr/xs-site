<div id="page-loader" class="page-loader" role="status" aria-label="Carregando">
  <img class="page-loader-logo" src="/icon.png" alt="XanaScript">
</div>
<script>
(function () {
  var loader = document.getElementById('page-loader');
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function hide() {
    if (loader) {
      loader.classList.add('hidden');
      setTimeout(function () { loader.remove(); }, 350);
    }
  }
  if (document.readyState === 'complete') {
    hide();
  } else {
    window.addEventListener('load', hide);
    setTimeout(hide, 1200);
  }
})();
</script>
<div id="cookie-banner" class="cookie-banner" role="dialog" aria-live="polite" hidden>
  <div class="cookie-banner-inner">
    <div class="cookie-banner-text">
      <strong>Privacidade e cookies</strong>
      <p>Usamos cookies estritamente necessarios para o funcionamento da plataforma. Ao continuar, voce concorda com nossa <a href="/privacy">Politica de Privacidade</a>.</p>
    </div>
    <div class="cookie-banner-actions">
      <button type="button" class="btn btn-secondary" id="cookie-reject">Apenas essenciais</button>
      <button type="button" class="btn" id="cookie-accept">Aceitar todos</button>
    </div>
  </div>
</div>
<script>
(function () {
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var io = null;
  var pending = [];

  function initObserver() {
    io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    pending.forEach(function (el) { io.observe(el); });
    pending = [];
  }

  // Reveal inner-page blocks (cards, quick-links) with stagger
  var pageEl = document.querySelector('.l-page');
  if (pageEl) {
    if (reduceMotion) {
      pageEl.classList.add('in-view');
    } else if ('IntersectionObserver' in window) {
      initObserver();
      io.observe(pageEl);
    } else {
      pageEl.classList.add('in-view');
    }
  }

  // Reveal-on-scroll elements (landing sections/cards)
  var revealEls = document.querySelectorAll('.reveal, .reveal-scale');
  if (revealEls.length) {
    if (reduceMotion || !('IntersectionObserver' in window)) {
      revealEls.forEach(function (el) { el.classList.add('in-view'); });
    } else {
      if (!io) initObserver();
      revealEls.forEach(function (el) { io.observe(el); });
    }
  }
})();
</script>
</body>
</html>