<div id="page-loader" class="page-loader" role="status" aria-label="Carregando">
  <img class="page-loader-logo" src="/icon.png" alt="XanaScript">
</div>
<script nonce="<%= cspNonce %>">
(function () {
  var toggle = document.getElementById('nav-toggle');
  var menu = document.getElementById('mobile-menu');
  var icon = document.getElementById('nav-toggle-icon');
  if (!toggle || !menu) return;
  function setOpen(open) {
    menu.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    menu.setAttribute('aria-hidden', open ? 'false' : 'true');
    if (icon) icon.textContent = open ? 'close' : 'menu';
  }
  toggle.addEventListener('click', function () {
    setOpen(!menu.classList.contains('open'));
  });
  menu.addEventListener('click', function (e) {
    if (e.target.closest('a, button')) setOpen(false);
  });
})();
</script>
<script nonce="<%= cspNonce %>">
(function () {
  function syncAuth() {
    var logged = !!localStorage.getItem('token');
    document.querySelectorAll('#nav-auth, #nav-auth-mobile').forEach(function (container) {
      container.querySelectorAll('.auth-user, .auth-guest').forEach(function (el) {
        var showUser = logged && el.getAttribute('data-auth') === 'user';
        var showGuest = !logged && el.getAttribute('data-auth') === 'guest';
        el.style.display = (showUser || showGuest) ? '' : 'none';
      });
    });
  }
  syncAuth();
  window.addEventListener('storage', syncAuth);
})();
</script>
<script nonce="<%= cspNonce %>">
window.logout = function () {
  localStorage.removeItem('token');
  document.cookie = 'xana_token=; path=/; max-age=0';
  window.location.href = '/';
};
</script>
<script nonce="<%= cspNonce %>">
(function () {
  var printBtns = document.querySelectorAll('.cert-print-btn');
  printBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      window.print();
    });
  });
})();
</script>
<script nonce="<%= cspNonce %>">
(function () {
  var loader = document.getElementById('page-loader');
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function hide() {
    if (loader) {
      loader.classList.add('hidden');
      setTimeout(function () { loader.remove(); }, 350);
    }
  }
  if (document.readyState === 'complete') {
    hide();
  } else {
    window.addEventListener('load', hide);
    setTimeout(hide, 1200);
  }
})();
</script>
<div id="cookie-banner" class="cookie-banner" role="dialog" aria-live="polite" hidden>
  <div class="cookie-banner-inner">
    <div class="cookie-banner-text">
      <strong>Privacidade e cookies</strong>
      <p>Usamos cookies estritamente necessarios para o funcionamento da plataforma. Ao continuar, voce concorda com nossa <a href="/privacy">Politica de Privacidade</a>.</p>
    </div>
    <div class="cookie-banner-actions">
      <button type="button" class="btn btn-secondary" id="cookie-reject">Apenas essenciais</button>
      <button type="button" class="btn" id="cookie-accept">Aceitar todos</button>
    </div>
  </div>
</div>
<script nonce="<%= cspNonce %>">
(function () {
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var io = null;
  var pending = [];

  function initObserver() {
    io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    pending.forEach(function (el) { io.observe(el); });
    pending = [];
  }

  // Reveal inner-page blocks (cards, quick-links) with stagger
  var pageEl = document.querySelector('.l-page');
  if (pageEl) {
    if (reduceMotion) {
      pageEl.classList.add('in-view');
    } else if ('IntersectionObserver' in window) {
      initObserver();
      io.observe(pageEl);
    } else {
      pageEl.classList.add('in-view');
    }
  }

  // Reveal-on-scroll elements (landing sections/cards)
  var revealEls = document.querySelectorAll('.reveal, .reveal-scale');
  if (revealEls.length) {
    if (reduceMotion || !('IntersectionObserver' in window)) {
      revealEls.forEach(function (el) { el.classList.add('in-view'); });
    } else {
      if (!io) initObserver();
      revealEls.forEach(function (el) { io.observe(el); });
    }
  }

  // Word-by-word text reveal inside cards (lands on the observer above)
  if (!reduceMotion) {
    document.querySelectorAll('.l-step p, .l-service p, .l-benefit p, .l-faq-item p').forEach(function (el) {
      var text = el.textContent.replace(/\s+/g, ' ').trim();
      if (!text || text.split(/\s+/).length < 3) return;
      var words = text.split(' ');
      el.innerHTML = words.map(function (w, i) {
        return '<span class="l-word" style="--i:' + i + '">' + w + '</span>';
      }).join(' ');
    });
  }

  // FAQ accordion: opening one closes the others
  var faqItems = document.querySelectorAll('.l-faq-item');
  if (faqItems.length) {
    faqItems.forEach(function (item) {
      item.addEventListener('toggle', function () {
        if (item.open) {
          faqItems.forEach(function (other) {
            if (other !== item) other.open = false;
          });
        }
      });
    });
  }
})();
</script>
</body>
</html>