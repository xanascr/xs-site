<header class="l-header">
  <div class="l-container">
    <div class="l-nav">
      <a class="l-brand" href="/"><img class="l-brand-logo" src="/icon.png" alt="XanaScript"></a>
      <nav class="l-nav-links">
        <a href="/docs" class="<%= path && path.startsWith('/docs') ? 'active' : '' %>">Docs</a>
        <a href="/playground" class="<%= path && path.startsWith('/playground') ? 'active' : '' %>">Playground</a>
        <a href="/courses" class="<%= path && path.startsWith('/courses') ? 'active' : '' %>">Cursos</a>
        <a href="/packages" class="<%= path && path.startsWith('/packages') ? 'active' : '' %>">Pacotes</a>
        <a href="/hackathons" class="<%= path && path.startsWith('/hackathons') ? 'active' : '' %>">Hackathons</a>
      </nav>
      <div class="l-nav-cta">
        <% if (typeof user !== 'undefined' && user) { %>
          <a class="btn-outline" href="/dashboard">Dashboard</a>
          <form action="/api/auth/logout" method="POST" class="inline-form">
            <button type="submit" class="btn-outline">Sair</button>
          </form>
        <% } else { %>
          <a class="btn-outline" href="/login">Entrar</a>
          <a class="btn-primary" href="/signup">Criar conta</a>
        <% } %>
      </div>
    </div>
  </div>
</header>