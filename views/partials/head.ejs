<%
  const _seoBrand = 'xanascript';
  const _brandName = 'XanaScript';
  const _baseUrl = 'https://xanascript.xyz';
  const _pageTitle = typeof title !== 'undefined' && title ? String(title).toLowerCase() : '';
  const _title = _pageTitle ? _seoBrand + ' — ' + _pageTitle : 'xanascript';
  const _desc = typeof description !== 'undefined' && description
    ? description
    : 'XanaScript é uma linguagem de programação com sintaxe em português: ORM embutido, compilador otimizante, gerenciador de pacotes e suporte a WebAssembly. Aprenda, codifique e publique do seu jeito.';
  const _canonical = _baseUrl + (typeof canonicalPath !== 'undefined' && canonicalPath ? canonicalPath : path);
  const _ogImage = typeof ogImage !== 'undefined' && ogImage ? ogImage : _baseUrl + '/og-image.png';
  const _robots = typeof seoIndexable !== 'undefined' && !seoIndexable ? 'noindex, nofollow' : 'index, follow';
  const _extra = typeof extraStyles !== 'undefined' && extraStyles ? (Array.isArray(extraStyles) ? extraStyles : [extraStyles]) : [];
%>
<script nonce="<%= cspNonce %>">document.documentElement.classList.add('js');</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="<%= _robots %>">
<meta name="description" content="<%= _desc %>">
<meta name="theme-color" content="#f25b66">
<meta name="author" content="@flazo0">
<title><%= _title %></title>
<link rel="canonical" href="<%= _canonical %>">
<link rel="icon" type="image/png" href="/icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200">
<link href="https://fonts.googleapis.com/css2?family=Google+Sans+Code:ital,wght,MONO@0,300..800,1;1,300..800,1&family=Inter+Tight:ital,wght@0,100..900;1,100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200">
<link rel="stylesheet" href="/css/app.css">
<% _extra.forEach(function(href) { %>
<link rel="stylesheet" href="<%= href %>">
<% }) %>
<meta property="og:type" content="<%= typeof ogType !== 'undefined' && ogType ? ogType : 'website' %>">
<meta property="og:site_name" content="<%= _brandName %>">
<meta property="og:locale" content="pt_BR">
<meta property="og:title" content="<%= _title %>">
<meta property="og:description" content="<%= _desc %>">
<meta property="og:url" content="<%= _canonical %>">
<meta property="og:image" content="<%= _ogImage %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= _title %>">
<meta name="twitter:description" content="<%= _desc %>">
<meta name="twitter:image" content="<%= _ogImage %>">
<% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
<script nonce="<%= cspNonce %>" type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>
<% } %>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-9TJLJ8352Q"></script>
<script nonce="<%= cspNonce %>">
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-9TJLJ8352Q');
</script>