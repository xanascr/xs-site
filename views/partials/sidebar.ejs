<aside class="sidebar">
  <div class="sidebar-brand"><a href="/">XanaScript</a></div>
  <nav class="sidebar-nav">
    <div class="sidebar-section">Plataforma</div>
    <a class="sidebar-link <%= typeof activeNav !== 'undefined' && activeNav === 'dashboard' ? 'active' : '' %>" href="/dashboard"><span class="material-symbols-outlined">space_dashboard</span>Dashboard</a>
