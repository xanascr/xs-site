<div class="l-page">
  <div class="page-header">
    <h1>Hackathons</h1>
  </div>
  <% if (hackathons.length === 0) { %>
    <div class="card"><div class="empty-state"><div class="icon material-symbols-outlined">emoji_events</div>Nenhum hackathon ainda.</div></div>
  <% } else { %>
    <div class="grid grid-2">
      <% hackathons.forEach(h => { %>
        <a class="quick-link stat-card-link" href="/hackathons/<%= h._id %>">
          <div class="name"><%= h.title %> <% if (h.active) { %><span class="badge badge-success">Ativo</span><% } else { %><span class="badge badge-neutral">Encerrado</span><% } %></div>
          <div class="desc mt-8"><%= h.description %></div>
          <div class="desc mt-8">Início: <%= new Date(h.startDate).toLocaleDateString() %> • Fim: <%= new Date(h.endDate).toLocaleDateString() %></div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>