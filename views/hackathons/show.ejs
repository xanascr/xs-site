<div class="l-page l-page-narrow">
  <a href="/hackathons" class="back-link">&larr; Todos os hackathons</a>
  <div class="card mb-16">
    <div class="card-body-lg">
      <div class="page-header no-border mb-12">
        <h1 class="sub-title" style="margin:0;"><%= hackathon.title %></h1>
        <% if (hackathon.active) { %><span class="badge badge-success">Ativo</span><% } else { %><span class="badge badge-neutral">Encerrado</span><% } %>
      </div>
      <p class="muted text-sm mb-16">Início: <%= new Date(hackathon.startDate).toLocaleDateString() %> • Fim: <%= new Date(hackathon.endDate).toLocaleDateString() %></p>
      <p class="muted mb-16"><%= hackathon.description %></p>
      <% if (hackathon.rules) { %>
        <div class="code-block rules-block"><%= hackathon.rules %></div>
      <% } %>
      <% if (hackathon.prize) { %>
        <p class="prize-line">Prêmio: <%= hackathon.prize %></p>
      <% } %>
    </div>
  </div>

  <div class="card mb-16">
    <div class="card-header">Submissões</div>
    <div class="card-body">
      <% if (submissions.length === 0) { %>
        <p class="muted">Nenhuma submissão ainda.</p>
      <% } else { %>
        <div class="feed">
          <% submissions.forEach(s => { %>
            <div class="feed-item">
              <div class="feed-body">
                <strong><%= s.title %></strong>
                <span class="muted text-sm">por <%= s.user?.username || '?' %></span>
                <span class="muted text-sm"><%= s.description %></span>
                <% if (s.link && s.link.startsWith('http')) { %><a href="<%= s.link %>" target="_blank" rel="noopener noreferrer" class="label-link text-sm">Ver projeto</a><% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <% if (hackathon.active) { %>
    <div class="card">
      <div class="card-header">Submeter Projeto</div>
      <div class="card-body">
        <form id="submit-form">
          <div class="form-group">
            <input class="form-control" name="title" placeholder="Título do projeto">
          </div>
          <div class="form-group">
            <textarea class="form-control" name="description" rows="3" placeholder="Descrição"></textarea>
          </div>
          <div class="form-group">
            <input class="form-control" name="link" placeholder="Link (opcional)">
          </div>
          <button type="submit" class="btn">Submeter</button>
        </form>
      </div>
    </div>
  <% } %>
</div>