<div class="l-page l-page-narrow">
  <h1>Benchmark</h1>
  <p class="muted mb-24">Comparativo de performance entre XanaScript, JavaScript, Python e Lua.</p>
  <div class="card">
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Teste</th><th>XS</th><th>JS</th><th>Python</th><th>Lua</th></tr>
        </thead>
        <tbody>
          <% benchmarks.forEach(b => { %>
            <tr>
              <td><%= b.name %></td>
              <td class="bench-xs"><%= b.xs %> <%= b.unit %></td>
              <td><%= b.js %> <%= b.unit %></td>
              <td><%= b.python %> <%= b.unit %></td>
              <td><%= b.lua %> <%= b.unit %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <p class="muted text-xs mt-12">* XS compilado para JS com otimizações. Menor = melhor.</p>
</div>