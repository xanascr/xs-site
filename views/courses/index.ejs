<div class="l-page">
  <div class="page-header">
    <h1>Cursos</h1>
  </div>
  <% if (courses.length === 0) { %>
    <div class="card"><div class="empty-state"><div class="icon material-symbols-outlined">school</div>Nenhum curso publicado ainda.</div></div>
  <% } else { %>
    <div class="grid grid-3">
      <% courses.forEach(c => { %>
        <a class="quick-link stat-card-link" href="/courses/<%= c.slug %>">
          <div class="name"><%= c.title %></div>
          <div class="stat-big"><%= c.modules.length %></div>
          <div class="desc"><%= c.description %></div>
          <div class="desc capitalize mt-8"><span class="badge badge-neutral"><%= c.level %></span> <span class="badge badge-neutral"><%= c.modules.length %> módulos</span></div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
