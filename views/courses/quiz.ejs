<div class="l-page l-page-narrow">
  <h1 class="sub-title"><%= quiz.title %></h1>
  <p class="muted mb-24"><%= course.title %></p>
  <form id="quiz-form">
    <% quiz.questions.forEach((q, i) => { %>
      <div class="card">
        <div class="card-body">
          <p class="quiz-question"><%= i + 1 %>. <%= q.question %></p>
          <% if (q.options?.length) { %>
            <% q.options.forEach(o => { %>
              <label class="quiz-option">
                <input type="radio" name="q<%= i %>" value="<%= o %>"><span><%= o %></span>
              </label>
            <% }) %>
          <% } else { %>
            <input name="q<%= i %>" class="form-control">
          <% } %>
        </div>
      </div>
    <% }) %>
    <button type="submit" class="btn btn-lg btn-block">Enviar respostas</button>
  </form>
  <p id="quiz-result" class="alert" style="display:none;"></p>
</div>
<script>
document.getElementById('quiz-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = new FormData(e.target);
  const answers = [];
  const total = <%= quiz.questions.length %>;
  for (let i = 0; i < total; i++) answers.push(form.get('q' + i) || '');
  const res = await fetch('/api/courses/<%= course._id %>/quiz/submit', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (localStorage.getItem('token') || '') },
    body: JSON.stringify({ answers, quizId: '<%= quiz._id %>' }),
  });
  const json = await res.json();
  const el = document.getElementById('quiz-result');
  el.style.display = 'block';
  el.textContent = 'Você acertou ' + json.score + ' de ' + json.total + ' (' + json.percent + '%)';
  el.className = 'alert text-center font-bold ' + (json.score >= json.total / 2 ? 'alert-success' : 'alert-error');
});
</script>