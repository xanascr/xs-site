<div class="l-page l-page-center">
  <div class="page-icon"><span class="material-symbols-outlined">workspace_premium</span></div>
  <h1 class="sub-title">Certificado de Conclusão</h1>
  <p class="muted mb-16">Certificamos que</p>
  <p class="cert-name"><%= cert.user?.username || user?.username %></p>
  <p class="muted mb-8">concluiu o curso</p>
  <p class="cert-course"><%= course.title %></p>
  <div class="card inline-block mb-24">
    <div class="card-body">
      <p class="muted text-xs">Código de verificação</p>
      <p class="mono cert-code"><%= cert.code %></p>
    </div>
  </div>
  <div>
    <button onclick="window.print()" class="btn btn-lg">Imprimir</button>
  </div>
</div>