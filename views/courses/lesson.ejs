<div class="l-page l-page-narrow">
  <a href="/courses/<%= course.slug %>" class="back-link">&larr; Voltar ao curso</a>
  <h1 class="sub-title"><%= lesson.title %></h1>
  <p class="muted mb-24"><%= course.title %></p>

  <div class="card mb-16">
    <div class="card-body md-raw"><%- lesson.bodyMd %></div>
  </div>

  <div class="filters mb-24">
    <% if (typeof user !== 'undefined' && user) { %>
      <button id="complete-btn" onclick="completeLesson('<%= course.slug %>', '<%= lesson.slug %>')" class="btn">
        <%= typeof enrollment !== 'undefined' && enrollment?.completedLessons?.some(l => l.lessonSlug === lesson.slug) ? 'Concluído' : 'Marcar como concluído' %>
      </button>
    <% } else { %>
      <a href="/login" class="btn">Faça login para se inscrever</a>
    <% } %>
  </div>

  <div class="card">
    <div class="card-header">Comentários</div>
    <div class="card-body">
      <div id="comments"></div>
      <% if (typeof user !== 'undefined' && user) { %>
        <form id="comment-form" class="mt-16">
          <div class="form-group">
            <textarea class="form-control" name="body" rows="3" placeholder="Comentário..." maxlength="5000"></textarea>
          </div>
          <button type="submit" class="btn">Enviar</button>
        </form>
      <% } %>
    </div>
  </div>
</div>
<script>
const token = localStorage.getItem('token');

async function loadComments() {
  const res = await fetch('/api/courses/<%= course._id %>/comments?lesson=<%= lesson.slug %>');
  const json = await res.json();
  const el = document.getElementById('comments');
  if (!json.comments?.length) { el.textContent = 'Nenhum comentário ainda.'; return; }
  el.innerHTML = '';
  json.comments.forEach(c => {
    const div = document.createElement('div');
    div.style.marginBottom = '12px';
    div.innerHTML = '<p style="font-size:14px;"><strong>' + escapeHtml(c.user?.username || '?') + '</strong> <span class="muted" style="font-size:12px;">' + new Date(c.createdAt).toLocaleDateString() + '</span></p><p class="muted" style="font-size:14px;"></p>';
    div.querySelector('p:last-child').textContent = c.body;
    el.appendChild(div);
  });
}

function escapeHtml(str) {
  const d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}

document.getElementById('comment-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const body = e.target.body.value.trim();
  if (!body) return;
  await fetch('/api/courses/<%= course._id %>/comments', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
    body: JSON.stringify({ lessonSlug: '<%= lesson.slug %>', body }),
  });
  e.target.body.value = '';
  loadComments();
});

async function completeLesson(courseSlug, lessonSlug) {
  await fetch('/api/courses/' + courseSlug + '/lessons/' + lessonSlug + '/complete', {
    method: 'POST',
    headers: { 'Authorization': 'Bearer ' + token },
  });
  document.getElementById('complete-btn').textContent = 'Concluído';
}

loadComments();
</script>
