<div class="l-page l-page-narrow">
  <a href="/courses/<%= course.slug %>" class="back-link"><span class="material-symbols-outlined link-icon">arrow_back</span> Voltar ao curso</a>
  <h1 class="sub-title"><%= lesson.title %></h1>
  <p class="muted mb-24"><%= course.title %> • Aula <%= lessonIndex + 1 %> de <%= allLessons.length %></p>

  <div class="card mb-16">
    <div class="card-body md-body"><%- renderMarkdown(lesson.bodyMd) %></div>
  </div>

  <div class="filters mb-24">
    <% if (typeof user !== 'undefined' && user) { %>
      <% if (typeof enrollment !== 'undefined' && enrollment) { %>
        <% const isDone = enrollment.completedLessons?.some(l => l.lessonSlug === lesson.slug); %>
        <form method="POST" action="/courses/<%= course.slug %>/lessons/<%= lesson.slug %>/complete" class="inline-form">
          <button type="submit" class="btn" <%= isDone ? 'disabled' : '' %>>
            <% if (isDone) { %>Aula concluída <span class="material-symbols-outlined btn-icon">check_circle</span><% } else { %>Marcar como concluída<% } %>
          </button>
        </form>
      <% } else { %>
        <a href="/courses/<%= course.slug %>" class="btn">Inscreva-se no curso para começar</a>
      <% } %>
    <% } else { %>
      <a href="/login" class="btn">Entre para acompanhar o curso</a>
    <% } %>
  </div>

  <div class="filters mb-24">
    <% if (typeof prevLesson !== 'undefined' && prevLesson) { %>
      <a href="/courses/<%= course.slug %>/lessons/<%= prevLesson.slug %>" class="btn-outline"><span class="material-symbols-outlined btn-icon">arrow_back</span> Anterior</a>
    <% } %>
    <% if (typeof nextLesson !== 'undefined' && nextLesson) { %>
      <a href="/courses/<%= course.slug %>/lessons/<%= nextLesson.slug %>" class="btn">Próxima aula <span class="material-symbols-outlined btn-icon">arrow_forward</span></a>
    <% } else if (typeof quiz !== 'undefined' && quiz) { %>
      <a href="/courses/<%= course.slug %>/quiz/<%= quiz._id %>" class="btn">Fazer o quiz <span class="material-symbols-outlined btn-icon">arrow_forward</span></a>
    <% } %>
  </div>

  <div class="card">
    <div class="card-header">Comentários</div>
    <div class="card-body">
      <div id="comments"></div>
      <% if (typeof user !== 'undefined' && user) { %>
        <form id="comment-form" class="mt-16">
          <div class="form-group">
            <textarea class="form-control" name="body" rows="3" placeholder="Comentário..." maxlength="5000"></textarea>
          </div>
          <button type="submit" class="btn">Enviar</button>
        </form>
      <% } %>
    </div>
  </div>
</div>
<script nonce="<%= cspNonce %>">
const token = localStorage.getItem('token');
const authHeader = token ? { 'Authorization': 'Bearer ' + token } : {};

async function loadComments() {
  const res = await fetch('/api/courses/<%= course._id %>/comments?lesson=<%= lesson.slug %>');
  const json = await res.json();
  const el = document.getElementById('comments');
  if (!json.comments?.length) { el.textContent = 'Nenhum comentário ainda.'; return; }
  el.innerHTML = '';
  json.comments.forEach(c => {
    const div = document.createElement('div');
    div.style.marginBottom = '12px';
    div.innerHTML = '<p style="font-size:14px;"><strong>' + escapeHtml(c.user?.username || '?') + '</strong> <span class="muted" style="font-size:12px;">' + new Date(c.createdAt).toLocaleDateString() + '</span></p><p class="muted" style="font-size:14px;"></p>';
    div.querySelector('p:last-child').textContent = c.body;
    el.appendChild(div);
  });
}

function escapeHtml(str) {
  const d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}

document.getElementById('comment-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const body = e.target.body.value.trim();
  if (!body) return;
  await fetch('/api/courses/<%= course._id %>/comments', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', ...authHeader },
    body: JSON.stringify({ lessonSlug: '<%= lesson.slug %>', body }),
  });
  e.target.body.value = '';
  loadComments();
});

loadComments();
</script>