<div class="auth-form-card">
  <div class="auth-form-head">
    <h1>Criar conta</h1>
    <p>Comece a programar em português.</p>
  </div>
  <form id="signup-form">
    <div class="form-group">
      <label for="username">Usuário</label>
      <div class="input-icon">
        <span class="material-symbols-outlined">person</span>
        <input class="form-control form-control-lg" type="text" id="username" name="username" placeholder="seu_usuario" required autocomplete="username" autofocus>
      </div>
    </div>
    <div class="form-group">
      <label for="email">E-mail</label>
      <div class="input-icon">
        <span class="material-symbols-outlined">mail</span>
        <input class="form-control form-control-lg" type="email" id="email" name="email" placeholder="seu@email.com" required autocomplete="email">
      </div>
    </div>
    <div class="form-group">
      <label for="password">Senha</label>
      <div class="input-icon">
        <span class="material-symbols-outlined">lock</span>
        <input class="form-control form-control-lg" type="password" id="password" name="password" placeholder="Mínimo 6 caracteres" required minlength="6" autocomplete="new-password">
      </div>
    </div>
    <p id="signup-error" class="alert alert-error" style="display:none"></p>
    <button type="submit" class="btn btn-lg btn-block">Criar conta</button>
    <p class="mt-16 muted" style="text-align:center">Já tem conta? <a href="/login">Entrar</a></p>
  </form>
</div>
<script>
document.getElementById('signup-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(e.target));
  const res = await fetch('/api/auth/signup', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
  const json = await res.json();
  const el = document.getElementById('signup-error');
  if (json.ok) {
    localStorage.setItem('token', json.token);
    window.location.href = '/';
  } else {
    el.textContent = json.error;
    el.style.display = 'block';
  }
});
</script>
