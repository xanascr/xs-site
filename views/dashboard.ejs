<div class="page-header">
  <div>
    <h1>Dashboard</h1>
    <p>Visão geral da sua conta</p>
  </div>
</div>

<div class="grid grid-3 mb-16">
  <div class="card stat-card">
    <span class="stat-icon"><span class="material-symbols-outlined">school</span></span>
    <span class="stat-label">Cursos matriculados</span>
    <span class="stat-value"><%= enrollments.length %></span>
  </div>
  <div class="card stat-card">
    <span class="stat-icon"><span class="material-symbols-outlined">inventory_2</span></span>
    <span class="stat-label">Pacotes publicados</span>
    <span class="stat-value"><%= packages.length %></span>
  </div>
  <div class="card stat-card">
    <span class="stat-icon"><span class="material-symbols-outlined">workspace_premium</span></span>
    <span class="stat-label">Cursos concluídos</span>
    <span class="stat-value"><%= enrollments.filter(e => e.completed).length %></span>
  </div>
</div>

<div class="card mb-16">
  <div class="card-header">Meus Cursos</div>
  <div class="card-body">
    <% if (enrollments.length === 0) { %>
      <div class="empty-state">
        <div class="icon material-symbols-outlined">school</div>
        Nenhum curso ainda. <a href="/courses">Ver cursos</a>
      </div>
    <% } else { %>
      <div class="quick-links">
        <% enrollments.forEach(e => { %>
          <%
            const total = e.course.modules?.flatMap(m => m.lessons)?.length || 0;
            const done = e.completedLessons?.length || 0;
            const pct = total ? Math.round((done / total) * 100) : 0;
          %>
          <a class="quick-link" href="/courses/<%= e.course.slug %>">
            <div class="name"><%= e.course.title %></div>
            <div class="desc"><%= done %> de <%= total %> aulas<%= e.completed ? ' • Concluído' : '' %></div>
            <div style="height:6px;background:rgba(242,91,102,.15);border-radius:999px;overflow:hidden;margin-top:8px;">
              <div style="height:100%;width:<%= pct %>%;background:var(--lp-primary);border-radius:999px;"></div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<div class="card">
  <div class="card-header">Meus Pacotes</div>
  <div class="card-body">
    <% if (packages.length === 0) { %>
      <div class="empty-state">
        <div class="icon material-symbols-outlined">inventory_2</div>
        Nenhum pacote ainda. <a href="/packages/dashboard">Publicar um</a>
      </div>
    <% } else { %>
      <div class="quick-links">
        <% packages.forEach(p => { %>
          <a class="quick-link" href="/packages/<%= p.name %>">
            <div class="name"><%= p.name %></div>
            <div class="desc">v<%= p.version %> • <%= p.downloads %> downloads</div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
