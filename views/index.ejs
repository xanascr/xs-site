<script nonce="<%= cspNonce %>">
(function () {
  var GITHUB_USERS = [
    'gabsmsenna',
    'flazo0',
    'luanderson-dev',
    'KelvinLR',
    'l3riel',
    'BryanPinheiro77',
    'luiz-freitass',
    '0064558',
    'rytechh',
    'guithepc',
    'lorena-naraujo',
    'euudanilo',
    'thiagoferlopes',
    'MatheusDev0705',
    'LuisG-santos',
    'Fernandofvsouza'
  ];
  var MAX_AVATARS = 6;
  var POOL_LIMIT = 100;
  var TOTAL_DEVS = 300;

  function shuffle(arr) {
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = arr[i];
      arr[i] = arr[j];
      arr[j] = tmp;
    }
    return arr;
  }

  var container = document.getElementById('social-avatars');
  var countEl = document.getElementById('social-count');
  if (!container || !countEl || !GITHUB_USERS.length) return;

  var pool = shuffle(GITHUB_USERS.slice()).slice(0, POOL_LIMIT);
  var shown = pool.slice(0, MAX_AVATARS);

  shown.forEach(function (user, i) {
    var span = document.createElement('span');
    span.className = 'l-avatar';
    span.style.background = 'linear-gradient(135deg,#f25b66,#e24b54)';
    var link = document.createElement('a');
    link.href = 'https://github.com/' + encodeURIComponent(user);
    link.target = '_blank';
    link.rel = 'noopener';
    link.title = '@' + user;
    var img = document.createElement('img');
    img.src = 'https://avatars.githubusercontent.com/' + encodeURIComponent(user) + '?size=128';
    img.alt = '@' + user;
    img.width = 34;
    img.height = 34;
    img.loading = 'lazy';
    link.appendChild(img);
    span.appendChild(link);
    container.appendChild(span);
  });

  if (TOTAL_DEVS > shown.length) {
    var more = document.createElement('span');
    more.className = 'l-avatar l-avatar-more';
    more.textContent = '+' + (TOTAL_DEVS - shown.length);
    container.appendChild(more);
  }

  countEl.textContent = TOTAL_DEVS + '+ devs';
})();
</script>
