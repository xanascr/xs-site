<div class="l-page">
  <h1>Documentação</h1>
  <div class="grid grid-3">
    <% Object.entries(categories).forEach(([cat, articles]) => { %>
      <div class="card">
        <div class="card-header capitalize"><%= cat %></div>
        <div class="card-body">
          <div class="quick-links quick-links-stack">
            <% articles.forEach(a => { %>
              <a class="quick-link" href="/docs/<%= a.slug %>"><div class="name"><%= a.title %></div></a>
            <% }) %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>