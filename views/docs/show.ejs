<div class="l-page">
  <div class="docs-layout">
    <aside class="card docs-nav">
      <div class="card-header">Índice</div>
      <div class="card-body">
        <div class="docs-link-list">
          <% all.forEach(a => { %>
            <a href="/docs/<%= a.slug %>" class="docs-link <%= a.slug === article.slug ? 'active' : '' %>"><%= a.title %></a>
          <% }) %>
        </div>
      </div>
    </aside>
    <article class="card docs-article">
      <div class="card-body">
        <h1 class="doc-title"><%= article.title %></h1>
        <div class="md-body"><%- renderMarkdown(article.body) %></div>
      </div>
    </article>
  </div>
</div>