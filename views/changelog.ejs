<div class="l-page l-page-narrow">
  <h1>Changelog</h1>
  <div class="feed">
    <% changelog.forEach(v => { %>
      <div class="card">
        <div class="card-body">
          <div class="meta-row">
            <strong style="font-size:16px;">v<%= v.version %></strong>
            <span class="muted text-sm"><%= v.date %></span>
            <span class="badge <%= v.type === 'major' ? 'badge-brand' : 'badge-neutral' %>"><%= v.type %></span>
          </div>
          <ul class="changelog-list">
            <% v.changes.forEach(c => { %>
              <li class="muted text-sm"><%= c %></li>
            <% }) %>
          </ul>
        </div>
      </div>
    <% }) %>
  </div>
</div>