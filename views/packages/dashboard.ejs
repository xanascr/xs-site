<div class="page-header">
  <div>
    <h1>Meus Pacotes</h1>
    <p>Publique e gerencie seus pacotes</p>
  </div>
</div>

<div class="card mb-16">
  <div class="card-header">Publicar novo pacote</div>
  <div class="card-body">
    <form id="publish-form" enctype="multipart/form-data">
      <div class="form-row">
        <div class="form-group">
          <label for="name">Nome *</label>
          <input class="form-control" type="text" id="name" name="name" required pattern="[a-z0-9_-]+" title="Apenas a-z, 0-9, _, -" placeholder="meu-pacote">
        </div>
        <div class="form-group">
          <label for="version">Versão *</label>
          <input class="form-control" type="text" id="version" name="version" required value="1.0.0">
        </div>
      </div>
      <div class="form-group">
        <label for="description">Descrição</label>
        <textarea class="form-control" id="description" name="description" rows="2" placeholder="O que o pacote faz"></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="license">Licença</label>
          <input class="form-control" type="text" id="license" name="license" value="MIT">
        </div>
        <div class="form-group">
          <label for="repository">Repositório</label>
          <input class="form-control" type="url" id="repository" name="repository" placeholder="https://">
        </div>
      </div>
      <div class="form-group">
        <label for="keywords">Keywords (separadas por vírgula)</label>
        <input class="form-control" type="text" id="keywords" name="keywords" placeholder="xs, linguagem, utilitário">
      </div>
      <div class="form-group">
        <label for="dependencies">Dependências (separadas por vírgula)</label>
        <input class="form-control" type="text" id="dependencies" name="dependencies" placeholder="axios, lodash">
      </div>
      <div class="form-group">
        <label for="readme">README (Markdown)</label>
        <textarea class="form-control" id="readme" name="readme" rows="6" placeholder="# Meu pacote"></textarea>
      </div>
      <div class="form-group">
        <label for="tarball">Tarball (.tar.gz) — máx 5MB</label>
        <input class="form-control" type="file" id="tarball" name="tarball" accept=".tar.gz,.tgz,.tar">
      </div>
      <p id="publish-result" class="alert" style="display:none"></p>
      <div class="form-actions">
        <button type="submit" class="btn">Publicar</button>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header">Pacotes publicados</div>
  <div class="table-wrap">
    <% if (packages.length === 0) { %>
      <div class="empty-state">
        <div class="icon material-symbols-outlined">inventory_2</div>
        Você não publicou nenhum pacote ainda.<br>Use o formulário acima ou <code class="mono">xs publish</code> no terminal.
      </div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Nome</th>
            <th>Versão</th>
            <th>Versões</th>
            <th>Downloads</th>
            <th>Status</th>
            <th>Criado</th>
          </tr>
        </thead>
        <tbody>
          <% packages.forEach(p => { %>
            <tr>
              <td><a href="/packages/<%= p.name %>"><%= p.name %></a></td>
              <td class="muted">v<%= p.version %></td>
              <td class="muted"><%= (p.versions || []).length %></td>
              <td><%= p.downloads %></td>
              <td>
                <% if (p.status === 'approved') { %><span class="badge badge-success">Aprovado</span>
                <% } else if (p.status === 'rejected') { %><span class="badge badge-danger">Rejeitado</span>
                <% } else { %><span class="badge badge-neutral">Pendente</span><% } %>
              </td>
              <td class="muted"><%= new Date(p.createdAt).toLocaleDateString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<script nonce="<%= cspNonce %>">
document.getElementById('publish-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target;
  const resultEl = document.getElementById('publish-result');
  resultEl.textContent = 'Publicando...';
  resultEl.className = 'alert';
  resultEl.style.display = 'block';
  const formData = new FormData(form);
  const token = localStorage.getItem('token');
  try {
    const res = await fetch('/api/packages', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + token },
      body: formData,
    });
    const data = await res.json();
    if (data.ok) {
      resultEl.textContent = 'Pacote publicado com sucesso!';
      resultEl.className = 'alert alert-success';
      setTimeout(() => window.location.reload(), 1500);
    } else {
      resultEl.textContent = data.error || 'Erro ao publicar';
      resultEl.className = 'alert alert-error';
    }
  } catch (err) {
    resultEl.textContent = 'Erro: ' + err.message;
    resultEl.className = 'alert alert-error';
  }
});
</script>
