<div class="l-page l-page-wide">
  <a href="/packages" class="back-link">&larr; Todos os pacotes</a>

  <div class="card mb-16">
    <div class="card-body-lg">
      <div class="pkg-head">
        <div>
          <h1 class="pkg-title"><%= pkg.name %></h1>
          <div class="meta-row">
            <span class="badge badge-brand">v<%= pkg.version %></span>
            <span class="badge badge-neutral">por <%= pkg.authorUsername || '?' %></span>
            <span class="badge badge-neutral"><%= pkg.downloads %> downloads</span>
            <% if (pkg.license && pkg.license !== 'MIT') { %><span class="badge badge-neutral"><%= pkg.license %></span><% } %>
          </div>
        </div>
        <div class="pkg-actions">
          <select id="version-select" class="form-control">
            <% (pkg.versions || []).forEach(v => { %>
              <option value="<%= v.version %>" <%= v.version === pkg.version ? 'selected' : '' %>><%= v.version %></option>
            <% }) %>
          </select>
          <button onclick="downloadPkg()" class="btn">
            <span class="material-symbols-outlined">download</span> Download
          </button>
        </div>
      </div>

      <p class="muted mb-20"><%= pkg.description || 'Sem descrição.' %></p>

      <div class="install-bar">
        <span class="mono">xs install <%= pkg.name %></span>
        <button onclick="copyCmd()" class="btn btn-secondary btn-sm">Copiar</button>
      </div>

      <% if (pkg.repository) { %>
        <a href="<%= pkg.repository %>" target="_blank" rel="noopener noreferrer" class="label-link repo-link">
          <span class="material-symbols-outlined">link</span> Repositório
        </a>
      <% } %>

      <% if (pkg.keywords && pkg.keywords.length > 0) { %>
        <div class="tag-row mb-16">
          <% pkg.keywords.forEach(k => { %><span class="tag"><%= k %></span><% }) %>
        </div>
      <% } %>

      <% if (pkg.readme) { %>
        <div class="readme-block">
          <h2 class="readme-title">README</h2>
          <div class="md-body"><%- renderMarkdown(pkg.readme) %></div>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">Avaliações</div>
    <div class="card-body">
      <% if (reviews && reviews.length > 0) { %>
        <% reviews.forEach(r => { %>
          <div class="review-item">
            <div class="cell-user mb-4">
              <span class="review-author"><%= r.user?.username || '?' %></span>
              <span class="review-stars"><%= '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating) %></span>
            </div>
            <% if (r.title) { %><p class="review-title"><%= r.title %></p><% } %>
            <% if (r.body) { %><p class="muted review-body"><%= r.body %></p><% } %>
          </div>
        <% }) %>
      <% } else { %>
        <p class="muted">Nenhuma avaliação ainda.</p>
      <% } %>
    </div>
  </div>
</div>
<script nonce="<%= cspNonce %>">
const pkgName = '<%= pkg.name %>';
const versions = <%- JSON.stringify((pkg.versions || []).map(v => v.version)) %>;
const sel = document.getElementById('version-select');

sel.addEventListener('change', () => {
  window.location.href = '/packages/' + pkgName + '/' + sel.value;
});

async function downloadPkg() {
  const ver = sel ? sel.value : '<%= pkg.version %>';
  const res = await fetch('/api/packages/' + pkgName + '/download?version=' + ver, { method: 'POST' });
  if (!res.ok) return alert('Erro ao baixar');
  const blob = await res.blob();
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = pkgName + '-' + ver + '.tar.gz';
  a.click();
  URL.revokeObjectURL(url);
}

function copyCmd() {
  navigator.clipboard.writeText('xs install ' + pkgName);
}

function escapeHtml(str) {
  if (!str) return '';
  var d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}
</script>