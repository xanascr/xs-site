<div class="l-page">
  <div class="page-header">
    <div>
      <h1>Pacotes</h1>
      <p>Publique e instale pacotes XanaScript</p>
    </div>
    <% if (typeof user !== 'undefined' && user) { %>
      <a class="btn" href="/packages/dashboard">Meus Pacotes</a>
    <% } %>
  </div>

  <form action="/packages" method="GET" class="filters">
    <input type="text" name="q" value="<%= query %>" placeholder="Buscar pacotes..." class="form-control packages-search">
    <button type="submit" class="btn">Buscar</button>
  </form>

  <% if (packages.length === 0) { %>
    <div class="card">
      <div class="empty-state">
        <div class="icon material-symbols-outlined">package_2</div>
        <%= query ? 'Nenhum pacote encontrado para "' + query + '".' : 'Nenhum pacote publicado ainda.' %>
        <% if (!query) { %><p class="muted mt-8">Use <code class="mono">xs publish</code> para publicar o seu.</p><% } %>
      </div>
    </div>
  <% } else { %>
    <div class="grid grid-3">
      <% packages.forEach(p => { %>
        <a class="quick-link stat-card-link" href="/packages/<%= p.name %>">
          <div class="name" style="color:var(--brand);"><%= p.name %></div>
          <div class="desc mt-8"><%= p.description || 'Sem descrição' %></div>
          <div class="desc mt-8">
            <span class="badge badge-neutral">v<%= p.version %></span>
            <span class="badge badge-neutral"><%= p.authorUsername || '?' %></span>
            <span class="badge badge-neutral"><%= p.downloads %> downloads</span>
            <% if (p.license && p.license !== 'MIT') { %><span class="badge badge-neutral"><%= p.license %></span><% } %>
          </div>
          <% if (p.keywords && p.keywords.length > 0) { %>
            <div class="tag-row mt-8">
              <% p.keywords.slice(0, 3).forEach(k => { %>
                <span class="tag"><%= k %></span>
              <% }) %>
            </div>
          <% } %>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>