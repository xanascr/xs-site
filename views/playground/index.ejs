<div class="l-page">
  <div class="page-header">
    <h1>Playground</h1>
    <span class="badge badge-brand">Ctrl+Enter para executar</span>
  </div>
  <div class="filters">
    <select id="example-select" class="form-control playground-select">
      <option value="">Exemplos...</option>
      <% examples.forEach(e => { %>
        <option value="<%= e._id %>"><%= e.title %></option>
      <% }) %>
    </select>
    <button onclick="runCode()" class="btn btn-lg">Executar</button>
  </div>
  <div class="grid grid-2 playground-grid">
    <textarea id="code-editor" class="code-block playground-editor" placeholder="Escreva seu código XS aqui..."></textarea>
    <div id="output" class="code-block playground-output"></div>
  </div>
</div>
<script>
const editor = document.getElementById('code-editor');
const output = document.getElementById('output');
const select = document.getElementById('example-select');

const examples = <%- JSON.stringify(examples.map(e => ({ _id: e._id, title: e.title, code: e.code }))) %>;

select.addEventListener('change', () => {
  const ex = examples.find(e => e._id === select.value);
  if (ex) editor.value = ex.code;
});

document.addEventListener('keydown', (e) => {
  if (e.ctrlKey && e.key === 'Enter') runCode();
});

async function runCode() {
  output.textContent = 'Executando...';
  try {
    const res = await fetch('/api/playground/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code: editor.value }),
    });
    const data = await res.json();
    output.textContent = data.ok
      ? (data.output || 'OK (sem saída)')
      : 'Erro: ' + (data.error || 'Erro desconhecido');
  } catch (e) {
    output.textContent = 'Erro: ' + e.message;
  }
}
</script>
